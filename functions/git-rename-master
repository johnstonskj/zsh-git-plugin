# shellcheck shell=bash # -*- mode: sh; eval: (sh-set-shell "zsh") -*-

typeset new_name
typeset old_name

if [[ "${1}" == "" ]] ; then
    new_name=main
else
    new_name="${1}"
fi

if [[ "${2}" == "" ]] ; then
    old_name=master
else
    old_name="${2}"
fi

if ! git branch -m "${old_name}" "${new_name}"; then
    echo "Error: git 'branch' command failed; errono=$?."
    return 2
fi

if ! git fetch origin; then
    echo "Error: git 'fetch' command failed; errono=$?."
    return 2
fi


if ! git branch -u origin/"${new_name}" "${new_name}"; then
    echo "Error: git 'branch' command failed; errono=$?."
    return 2
fi


if ! git remote set-head origin -a; then
    echo "Error: git 'remote set-head' command failed; errono=$?."
    return 2
fi

return 0
