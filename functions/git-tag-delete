# shellcheck shell=bash # -*- mode: sh; eval: (sh-set-shell "zsh") -*-

typeset tag_name="${1}"

if [[ -z "${tag_name}" ]]; then
    echo "Usage: ${0:t} tag-name"
    return 1
fi

if ! git push --delete origin "${tag_name}"; then
    echo "Error: git 'push' delete command failed; errono=$?."
    return 2
fi

if ! git tag -d "${tag_name}"; then
    echo "Error: git 'tag' delete command failed; errono=$?."
    return 2
fi

return 0
